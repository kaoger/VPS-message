# production 必填以下 Meta / 公開網址 / 表單密鑰設定。
NODE_ENV=production

PORT=3000

# 固定 HTTPS 網站根網址，不含路徑、查詢參數或尾斜線。
PUBLIC_BASE_URL=

META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# 選填；未設定時不寫入 CRM，仍回傳摘要。金鑰只供伺服器使用。
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 舊版相容名稱；優先使用 SUPABASE_SECRET_KEY。
SUPABASE_SERVICE_ROLE_KEY=

# 預設 webform；chat 為 Messenger 逐題問答。
DEMO_MODE=webform
# 留空使用 config/questions.json；兩種模式共用。
QUESTIONS_PATH=
# production 必填至少 32 字元；開發環境未設定時使用每次啟動的新密鑰。
FORM_TOKEN_SECRET=
# 選填：日誌路徑；預設只輸出 stdout，交給 systemd 管理。
LOG_PATH=
# 只有單層本機反向代理且覆寫 X-Forwarded-For 時才設 true。
TRUST_LOCAL_PROXY=false

# 只有先在 Meta Messenger 設定中允許 bot.sameheart-design.com 後才改為 true。
# 開啟後表單以 Messenger Webview 開啟，成功送出時嘗試自動返回對話。
MESSENGER_WEBVIEW_ENABLED=false

# 管理頁 /admin 專用；缺少或無效時僅管理頁回 503，不影響機器人啟動。
# 下列值均為佔位值；App ID 2981721165529622 為公開資訊。
META_APP_ID=YOUR_META_APP_ID
# Facebook Login for Business configuration：User access token、Pages 資產、四項權限。
META_LOGIN_CONFIG_ID=YOUR_LOGIN_CONFIG_ID
# 本 App 範圍使用者 ID，逗號分隔；不是一般 Facebook profile ID。
ADMIN_FB_USER_IDS=YOUR_APP_SCOPED_USER_ID
# 至少 32 bytes 的獨立隨機密鑰，請在伺服器私下產生，不使用此佔位字串。
ADMIN_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# 僅支援三禾粉絲專頁；公開 Page ID，不可填其他 Page。
ADMIN_ALLOWED_PAGE_ID=157645098246646
# 選填：限制企業並驗證該企業擁有三禾 Page；不填則顯示登入者授權的企業。
ADMIN_ALLOWED_BUSINESS_ID=
