# production 必填以下 Meta / 公開網址 / 表單密鑰設定。
NODE_ENV=production

PORT=3000

# 固定 HTTPS 網站根網址，不含路徑、查詢參數或尾斜線。
PUBLIC_BASE_URL=

META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# 選填；未設定時不寫入 CRM，仍回傳摘要。金鑰只供伺服器使用。
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 舊版相容名稱；優先使用 SUPABASE_SECRET_KEY。
SUPABASE_SERVICE_ROLE_KEY=

# 預設 webform；chat 為 Messenger 逐題問答。
DEMO_MODE=webform
# 留空使用 config/questions.json；兩種模式共用。
QUESTIONS_PATH=
# production 必填至少 32 字元；開發環境未設定時使用每次啟動的新密鑰。
FORM_TOKEN_SECRET=
# 選填：日誌路徑；預設只輸出 stdout，交給 systemd 管理。
LOG_PATH=
# 同一位使用者的填表邀請冷卻分鐘數。
INVITE_COOLDOWN_MINUTES=30
# 只有單層本機反向代理且覆寫 X-Forwarded-For 時才設 true。
TRUST_LOCAL_PROXY=false
